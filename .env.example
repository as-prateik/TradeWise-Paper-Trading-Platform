# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required. At least 32 characters; the app refuses to start without it.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Optional. Without it the app runs on simulated prices (and says so in the UI).
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Optional overrides
# DB_PASSWORD=tradewise
# ALPHAVANTAGE_DAILY_BUDGET=20
# WALLET_SEED_BALANCE=100000.0000
